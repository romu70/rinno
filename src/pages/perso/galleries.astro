---
import ProjectPersonal from "../../layouts/ProjectPersonal.astro";
import Section from "../../components/project/Section.astro";
import Card from "../../components/project/Card.astro";
import Keywords from "../../components/project/Keywords.astro";
import Figure from "../../components/project/Figure.astro";
import Swatches from "../../components/project/Swatches.astro";
import Timeline from "../../components/project/Timeline.astro";
import Iteration from "../../components/project/Iteration.astro";
import FactGrid from "../../components/project/FactGrid.astro";
import Outcomes from "../../components/project/Outcomes.astro";
import LearningsGrid from "../../components/project/LearningsGrid.astro";
import Learning from "../../components/project/Learning.astro";

import heroImage from "../../assets/perso/galleries/hero.jpg";
import userJourney1 from "../../assets/perso/galleries/user-journey.png";
import userJourney2 from "../../assets/perso/galleries/user-journey-2.jpg";
import mobile from "../../assets/perso/galleries/mobile.jpg";
import widescreen from "../../assets/perso/galleries/widescreen.jpg";
import skill from "../../assets/perso/galleries/skill.png";

const chapters = [
  { id: "contexte", label: "Contexte" },
  { id: "ui", label: "UI design" },
  {
    id: "iterations",
    label: "Itérations",
    children: [
      { id: "it1", label: "1 · Construire" },
      { id: "it2", label: "2 · Publier avec l'iPhone" },
      { id: "it3", label: "3 · Mur au fil du temps" },
      { id: "it4", label: "3 · Une page plus légère" },
    ],
  },
  { id: "situation", label: "En situation" },
  { id: "apprentissages", label: "Apprentissages" },
];
---

<ProjectPersonal
  title="Galleries"
  eyebrow="Projet personnel · Web · 2023 — présent"
  lede="Une galerie virtuelle pour exposer mes photos de typographies et de street art — <em>et un terrain d'apprentissage, du code à l'IA agentique.</em>"
  meta={[
    { label: "Type", value: "Projet personnel" },
    { label: "Stack", value: "Astro · TypeScript" },
    { label: "Hébergement", value: "GitHub Pages" },
    {
      label: "Site",
      value: "Voir la galerie",
      href: "https://romu70.github.io/galleries/",
    },
  ]}
  image={heroImage}
  imageAlt="Page d'accueil de Galleries : galeries Fonts et Street Art"
  imageDark
  chapters={chapters}
>
  <!-- 01 -->
  <Section id="contexte" number={1} title="Contexte">
    <p class="intro">
      Passionné par les polices de caractères et le street art, je capture et
      collecte des photos, qui s'accumulent sur mon téléphone depuis des années.
    </p>
    <p>
      Je me suis donc lancé dans le développement d'une galerie virtuelle,
      calquée sur celle de DuckDuckGo que j'aime beaucoup, pour exposer ces
      images.
    </p>
    <Card title="Challenge" class="challenge">
      <ul class="list-arrow">
        <li>Aiguiser mes compétences en développement web</li>
        <li>Créer une galerie performante et esthétique</li>
        <li>Gérer efficacement de nombreuses images</li>
        <li>Approfondir l'approche composants en web</li>
        <li>
          M'appuyer sur les capacités de l'IA agentique pour faciliter
          traitement et publication
        </li>
      </ul>
      <p class="card-end">
        Bien sûr, la galerie devait être utilisable sur téléphone et sur écran
        large.
      </p>
    </Card>
  </Section>

  <!-- 02 -->
  <Section id="ui" number={2} title="UI design">
    <p>
      Les images sont très colorées : la charte devait rester neutre pour ne pas
      perturber le visionnage. Seulement 3 couleurs.
    </p>
    <Swatches
      label="Palette de Galleries"
      colors={[
        { name: "Fond", hex: "#303030" },
        { name: "Textes", hex: "#FFFFFF" },
        { name: "Hover & active", hex: "#464646" },
      ]}
    />
  </Section>

  <!-- 03 -->
  <Section id="iterations" number={3} title="Quatre itérations">
    <p>
      Après une première version faite "à la main", l'IA agentique entre en
      scène. Je cadre les problèmes, je décide, je revois les changements
      proposés. Claude pour les réflexions, Claude Code pour développer. Je
      supervise, une PR à la fois.
    </p>
    <p></p>
    <Timeline>
      <Iteration n={1} title="Construire la galerie" tool="Astro" id="it1">
        <FactGrid
          flush
          items={[
            {
              label: "Choix de la stack",
              value:
                "Sur les conseils d'un ami développeur front-end, <a href=\"https://www.linkedin.com/in/guillaume-denier/\">Guillaume Denier</a>, j'ai choisi Astro : génération statique, proche des standards web, approche composants accessible. Promesses tenues !",
            },
            {
              label: "Hébergement",
              value:
                "Code sur GitHub, site statique sans collecte de données : GitHub Pages s'imposait, avec son pipeline CI/CD intégré.",
            },
            {
              label: "Collections par thème",
              value:
                "Les 2 galeries reposent sur les Content Collections d'Astro. Pour mieux connaître le système, l'une est en markdown, l'autre en JSON.",
            },
            {
              label: "Galerie responsive",
              value:
                "J'ai développé en TypeScript tout le fonctionnement de la galerie : formats portrait / paysage, navigation, clavier, etc.",
            },
          ]}
        />
      </Iteration>

      <Iteration n={2} title="Publier depuis l'iPhone" tool="Claude" id="it2">
        <p class="trigger">Constat : la flemme</p>
        <p>
          Les photos s'accumulaient et ma motivation baissait. Modéliser mon
          propre user journey m'a éclairé : ouvrir l'image, récupérer sa
          position, la chercher sur OpenStreetMap, renseigner les métadonnées
          dans un fichier Astro, redimensionner, compresser… 5 minutes par
          image, et tout passait par l'ordinateur.
        </p>
        <Figure
          image={userJourney1}
          alt="User journey original"
          caption="User journey original"
          label="Avant"
          labelTone="no"
        />
        <p class="trigger">Solution : plus d'ordinateur du tout</p>
        <p>
          Le vrai goulot n'était pas le déploiement, déjà automatique : c'était
          l'ordinateur. Avec Claude Code, utilisé depuis l'app Claude, j'ai
          reconstruit toute la chaîne autour du téléphone. Un Raccourci iOS
          envoie les photos, un skill Claude les traite et me soumet ce qu'il a
          reconnu (lieu, date, sujet), je valide, puis je fusionne la pull
          request sur GitHub.
        </p>
        <Figure
          image={userJourney2}
          alt="User journey actuel"
          caption="User journey actuel"
          label="Après"
          labelTone="yes"
        />
        <p class="trigger">résultat</p>
        <p>
          Moins d'une minute pour un lot de 5 images en général, contre 5
          minutes par image avant. En asynchrone, à mon rythme, sans ordinateur.
        </p>
        <p></p>
        <FactGrid
          flush
          items={[
            {
              label: "Garder l'humain dans la boucle",
              value:
                "Une session interactive où je valide les propositions de Claude, plutôt qu'un traitement entièrement automatique.",
            },
            {
              label: "Rien ne traîne",
              value:
                "Les originaux sont supprimés après traitement, et un garde-fou empêche de les publier par erreur.",
            },
          ]}
        />
      </Iteration>

      <Iteration
        n={3}
        title="Ce mur au fil du temps"
        tool="Claude"
        id="it3"
        current
      >
        <p class="trigger">un mur se repeint</p>
        <p>
          Le street art se repeint, sur les mêmes murs, mais impossible de voir
          l'histoire d'un mur.
        </p>
        <p>
          Dans la vue détail d'une photo, une frise permet désormais de remonter
          le temps sur le même mur. Une skill dédiée regroupe les photos : elle
          compare visuellement les candidates proches, et je tranche chaque
          groupe depuis mon téléphone.
        </p>
        <p></p>
        <FactGrid
          flush
          items={[
            {
              label: "Un mur, une surface",
              value:
                "Un pilier de pont peint sur quatre faces, c'est quatre murs.",
            },
            {
              label: "Le GPS propose, je confirme",
              value:
                "La proximité seule ne suffit pas (murs voisins, erreurs GPS) : l'agent propose, je décide.",
            },
          ]}
        />
      </Iteration>
      <Iteration
        n={4}
        title="Une page bien plus légère"
        tool="Claude"
        id="it4"
        current
      >
        <p>
          Certaines visites étaient très lentes. Mesure : la page street art
          téléchargeait ses 340 photos dès le premier chargement, soit 81,4 Mo,
          malgré le chargement différé.
        </p>
        <p>
          Dans la vue détail d'une photo, une frise permet désormais de remonter
          le temps sur le même mur. Une skill dédiée regroupe les photos : elle
          compare visuellement les candidates proches, et je tranche chaque
          groupe depuis mon téléphone.
        </p>
        <p></p>
        <FactGrid
          flush
          items={[
            {
              label: "Les causes",
              value:
                '<ul class="list-arrow"><li>Les panneaux de détail cachés recouvraient l\'écran : le navigateur jugeait chaque grande image visible et la téléchargeait.</li><li>Les vignettes étaient le fichier de 1 600 px, pour un cadre de 240 à 480 px.</li></ul>',
            },
            {
              label: "Les corrections",
              value:
                '<ul class="list-arrow"><li>Corriger la cause en CSS.</li><li>Vignettes plafonnées à 800 px : à 1 200 px, la page pesait encore 3,2 Mo sur iPhone.</li><li>Grande image chargée à l\'ouverture seulement, voisines préchargées pour garder une navigation instantanée.</li></ul>',
            },
            {
              label: "Résultat",
              wide: true,
              value:
                "Corrigé et fusionné le jour même. Sur iPhone 13, premier chargement : 8 images et 0,9 Mo au lieu de 81,4 Mo. Sur ordinateur : 2,1 Mo. Mesuré par un script versionné dans le dépôt, sur un build local.",
            },
          ]}
        />
      </Iteration>
    </Timeline>
  </Section>

  <!-- 04 -->
  <Section id="situation" number={4} title="En situation">
    <div class="grid-2 grid-wide-narrow">
      <Figure
        image={widescreen}
        alt="Rendu de Galleries sur écran large"
        caption="Écran large"
        dark
        sizes="(min-width: 1200px) 37rem, (min-width: 768px) 62vw, 100vw"
      />
      <div class="mobile-shot">
        <Figure
          image={mobile}
          alt="Rendu de Galleries sur mobile"
          caption="Mobile"
          dark
          width="17.5rem"
          center
          sizes="17.5rem"
        />
      </div>
    </div>
  </Section>

  <!-- 05 -->
  <Section id="apprentissages" number={5} title="Apprentissages et résultats">
    <LearningsGrid>
      <Learning n={1}>
        <p>
          Compétences TypeScript renforcées : typage, gestion d'événements,
          responsivité.
        </p>
      </Learning>
      <Learning n={2}>
        <p>
          Expérience concrète de conception et développement augmenté par l'IA
          avec Claude. Je ne touche plus au code. Claude fait tout, sous ma
          supervision.
        </p>
      </Learning>
      <Learning n={3}>
        <p>
          Mise en œuvre concrète de l'IA agentique : le skill Claude orchestre
          toute la procédure d'ajout de nouvelles images depuis mon téléphone.
        </p>
      </Learning>
      <Learning n={4}>
        <p>
          Rencontres avec certains des artistes exposés, comme <strong
            >Ador</strong
          >,
          <strong>Ratz One</strong>, <strong>Stend</strong> ou <strong
            >Tanala</strong
          >, que je remercie de m'avoir autorisé à reproduire leur travail.
        </p>
      </Learning>
    </LearningsGrid>
  </Section>

  <Keywords>
    <span class="keyword">Astro</span>
    <span class="keyword">TypeScript</span>
    <span class="keyword">JavaScript</span>
    <span class="keyword">GitHub Pages</span>
    <span class="keyword">IA agentique</span>
    <span class="keyword">Skill Claude</span>
    <span class="keyword">Typographie</span>
    <span class="keyword">Street art</span>
  </Keywords>
</ProjectPersonal>

<style>
  .challenge {
    margin-top: 2rem;
  }

  .card-end {
    margin-top: 0.9rem;
  }

  .mobile-shot :global(figcaption) {
    text-align: center;
  }
</style>
