---
import ProjectPersonal from "../../layouts/ProjectPersonal.astro";
import Section from "../../components/project/Section.astro";
import Learnings from "../../components/project/Learnings.astro";
import LearningsGrid from "../../components/project/LearningsGrid.astro";
import Learning from "../../components/project/Learning.astro";
import Keywords from "../../components/project/Keywords.astro";
import LinkList from "../../components/project/LinkList.astro";
import Figure from "../../components/project/Figure.astro";
import Tabs from "../../components/project/Tabs.astro";
import TabPanel from "../../components/project/TabPanel.astro";
import Quote from "../../components/project/Quote.astro";
import heroImage from "../../assets/perso/thot/hero.png";
import refugees from "../../assets/perso/thot/refugees.png";
import persona1 from "../../assets/perso/thot/persona-azeem.jpeg";
import persona2 from "../../assets/perso/thot/persona-mohammad.jpeg";
import journey from "../../assets/perso/thot/experience-map.jpeg";
import paper from "../../assets/perso/thot/paper.png";
import architecture from "../../assets/perso/thot/architecture.png";
import userflow from "../../assets/perso/thot/userflow.png";
import wireframes from "../../assets/perso/thot/wireframes.png";
import test from "../../assets/perso/thot/test.png";
import charte from "../../assets/perso/thot/charte.png";
import ticket from "../../assets/perso/thot/ticket.png";

const half = "(min-width: 1200px) 27rem, (min-width: 768px) 45vw, 100vw";
const panel = "(min-width: 1200px) 33rem, (min-width: 768px) 58vw, 100vw";

const chapters = [
  { id: "brief", label: "Brief & contexte" },
  { id: "recherche", label: "Recherche & pivot" },
  { id: "concept", label: "Concept" },
  {
    id: "conception",
    label: "Conception",
    children: [
      { id: "pwa", label: "PWA" },
      { id: "test-papier", label: "Tester le concept" },
      { id: "taxonomie", label: "Taxonomie" },
      { id: "parcours", label: "Parcours utilisateur" },
      { id: "wireframes", label: "Wireframes" },
      { id: "charte", label: "Charte graphique" },
      { id: "ticket", label: "Ticket" },
    ],
  },
  { id: "prototype", label: "Prototype final" },
  { id: "enseignements", label: "Enseignements" },
];
---

<ProjectPersonal
  title="THoT - Sia"
  eyebrow="Gobelins · Certification UX Design · 2017"
  meta={[
    { label: "Rôle", value: "UX Designer" },
    { label: "Équipe", value: "3 personnes" },
    { label: "Durée", value: "3 mois" },
    { label: "Prototype", value: "Voir le prototype", href: "/Sia/index.html" },
  ]}
  image={heroImage}
  imageAlt="Maquettes de l'application Sia"
  chapters={chapters}
>
  <!-- 01 -->
  <Section id="brief" number={1} title="Brief du projet">
    <p>
      <strong>Commanditaire :</strong> École THoT, qui enseigne le français aux aux
      personnes en exil, représentée par sa présidente et fondatrice <a
        href="https://www.linkedin.com/in/judith-aquien/"
        target="_blank">Judith Aquien</a
      >.
    </p>
    <Quote author="Judith Aquien">
      <p>
        Permettre aux personnes en exil de trouver leurs marques dans Paris et
        d’apprendre au passage les bases qui leur donneront une autonomie en
        français.
      </p>
    </Quote>
    <h3>Contexte</h3>
    <p>
      Projet de fin de formation de la certification UX Design aux Gobelins à
      Paris.
    </p>
    <p><strong>Equipe : </strong>3 personnes</p>
    <ul class="list-arrow">
      <li>
        <a href="https://www.linkedin.com/in/aureliedunier/" target="_blank"
          >Aurélie Dunier</a
        >
      </li>
      <li>
        <a href="https://www.linkedin.com/in/jpchevin/" target="_blank"
          >Jean-Philippe Chevin</a
        >
      </li>
      <li>
        <a href="https://www.linkedin.com/in/romutisserand/" target="_blank"
          >Moi même</a
        >
      </li>
    </ul>
  </Section>

  <!-- 02 -->
  <Section id="recherche" number={2} title="De la recherche terrain au pivot">
    <h3>Recherche terrain</h3>
    <div class="grid-2 split">
      <div class="section-content">
        <p>
          Après une phase de recherche secondaire sur la question des exilés en
          France, nous avons arpenté le terrain pendant 2 jours.
        </p>
        <ul class="list-arrow">
          <li>Visite à la Porte de la Chapelle avec l'ONG Utopia 56</li>
          <li>Rencontre avec la directrice du Centre Primo Lévi</li>
          <li>Rencontre avec des personnels de RFI Savoirs</li>
          <li>
            Echanges directs avec 6 réfugiés venant d'Afghanistan, Érythrée et
            Soudan
          </li>
        </ul>
      </div>
      <Figure
        image={refugees}
        alt="5 des 6 réfugiés interrogés"
        caption="5 des 6 réfugiés interrogés"
        sizes={half}
      />
    </div>

    <h3>L'isolement est le problème</h3>
    <p>
      <strong>Enseignement :</strong> la préoccupation n°1 des réfugiés n'est pas
      de trouver leur marque dans Paris, mais de sortir de l'isolement.
    </p>
    <p>
      Ils sont seuls, dépendants des personnels des ONG, dans un pays dont ils ne
      maîtrisent ni la langue, ni la culture, ni les codes de socialisation.
    </p>
    <p>
      Leur seul souhait est de s'insérer dans la société pour y mener une vie
      normale.
    </p>
    <Quote author="E. Morel" role="Directrice du Centre Primo Lévi">
      <p>La première souffrance des réfugiés est l’isolement.</p>
    </Quote>
    <p>
      Pourtant, beaucoup d'activités de socialisation sont organisées par les ONG
      et la population pour aider les réfugiés. Mais ils ne le savent pas. Ce
      sera le point de départ de notre proposition.
    </p>

    <Tabs variant="tabs" label="Aller plus loin sur cette recherche">
      <TabPanel id="recherche-azeem" title="Persona Azeem">
        <Figure
          image={persona1}
          alt="Persona Azeem (Prénom changé)"
          caption="Persona Azeem (Prénom changé)"
          sizes={panel}
        />
      </TabPanel>
      <TabPanel id="recherche-mohammad" title="Persona Mohammad">
        <Figure
          image={persona2}
          alt="Persona Mohammad (Prénom changé)"
          caption="Persona Mohammad (Prénom changé)"
          sizes={panel}
        />
      </TabPanel>
      <TabPanel id="recherche-journey" title="Refugee journey">
        <Figure
          image={journey}
          alt="Parcours d'un réfugié à Paris"
          caption="Parcours d'un réfugié à Paris"
          sizes={panel}
        />
      </TabPanel>
    </Tabs>
  </Section>

  <!-- 03 -->
  <Section
    id="concept"
    number={3}
    title="Connecter les réfugiés aux manifestations locales"
  >
    <p class="intro">
      Pour lutter contre l'isolement des réfugiés, et leur permettre de
      pratiquer le Français, nous avons imaginé l'application <strong>Sia</strong
      >.
    </p>
    <p>
      Comme THoT, Sia est une figure de la mythologie égyptienne qui représente
      l'intuition et la clairvoyance. Le S représente le lien et la relation
      sociale.
    </p>
    <p>Les réfugiés peuvent utiliser <strong>Sia</strong> pour :</p>
    <ul class="list-arrow">
      <li>
        Consulter les manifestations organisées par les associations et la
        population
      </li>
      <li>S'inscrire pour participer aux activités</li>
      <li>Apporter de la confiance en montrant qui participe aux activités</li>
      <li>
        Obtenir des bases sur le vocabulaire français, avec une facilité de
        traduction activable à la demande
      </li>
      <li>
        Partager leurs expériences et leurs connaissances avec d'autres réfugiés
      </li>
      <li>
        Acquérir des bases de la culture française par l'intégration des
        saynètes, en partenariat avec RFI Savoirs
      </li>
    </ul>
  </Section>

  <!-- 04 -->
  <Section id="conception" number={4} title="Conception">
    <h3 id="pwa">PWA pour rester furtif</h3>
    <p>
      Un téléphone est indispensable avant de prendre le chemin de l'exil. Tous
      les réfugiés sont équipés d'un smartphone.
    </p>
    <p>
      Cependant, utiliser les app stores représente un risque (perçu par les
      réfugiés) d'être géolocalisé par les autorités. C'est pourquoi notre
      proposition est celle d'une PWA.
    </p>
    <Learnings variant="note">
      <p>
        <strong>PWA - Progressive Web App :</strong> Application web utilisable sur
        un téléphone sans passer par les app stores.
      </p>
    </Learnings>

    <h3 id="test-papier">Tester notre concept</h3>
    <div class="grid-2 split">
      <Figure
        image={paper}
        alt="Prototype papier"
        caption="Prototype papier"
        sizes={half}
      />
      <div class="section-content">
        <p>
          Les premiers tests du concept ont été réalisés en imprimant sur papier
          des maquettes très basiques, visibles ici. Ces premiers essais ont
          permis de valider le concept tout en donnant des pistes
          d'améliorations.
        </p>
        <ul class="list-arrow">
          <li>Le bouton "Yes I go" n'a pas été compris.</li>
          <li>
            Tous ne lisent pas bien, l'iconographie est critique pour identifier
            les activités.
          </li>
          <li>
            Les cercles gris sensés montrer des personnes n'ont pas été compris.
          </li>
          <li>
            Il est plus important d'illustrer que l'activité est une projection
            de fillm (compréhension directe) que de montrer le visuel d'un film
            qu'ils ne connaissent pas.
          </li>
        </ul>
      </div>
    </div>

    <h3 id="taxonomie">Taxonomie des activités</h3>
    <p>
      Avoir un filtre d'activités pertinent nécessitait d'avoir correctement
      défini la taxonomie et la hiérarchie des activités.
    </p>
    <Figure
      image={architecture}
      alt="Hiérarchie des activités"
      caption="Hiérarchie des activités"
    />

    <h3 id="parcours">Parcours utilisateur</h3>
    <p>
      Après les premières phases de conception, nous avions les idées claires
      pour le parcours utilisateur de l'application.
    </p>
    <Figure image={userflow} alt="Parcours utilisateur" caption="Parcours utilisateur" />

    <h3 id="wireframes">Affiner le prototype</h3>
    <div class="grid-2 split">
      <div class="section-content">
        <p>
          Le concept validé, nous avons commencé à travailler l'expérience
          utilisateur avec des wireframes.
        </p>
        <p>
          On retrouve la navigation initialement envisagée, plus quelques idées
          nouvelles révélées par les tests, comme la nécessaire maîtrise du
          Français.
        </p>
        <ul class="list-arrow">
          <li>
            Une aide linguistique activable à la demande pour acculturer les
            réfugiés au Français.
          </li>
          <li>
            Un menu qui se révèle et se cache pour filtrer les catégories
            d'activités.
          </li>
        </ul>
      </div>
      <div class="section-content">
        <Figure
          image={wireframes}
          alt="Wireframes"
          caption="Wireframes"
          sizes={half}
        />
        <p>
          Le menu de navigation pour s'orienter dans les activités proposées
          reprenait le symbole de la boussole, en lien avec l'exil des réfugiés.
          Mais c'était les ramener à une expérience qui reste douloureuse,
          l'avons remplacé par un symbole plus neutre.
        </p>
      </div>
    </div>

    <h3 id="charte">Charte graphique</h3>
    <div class="grid-2 split">
      <div class="section-content">
        <p>La direction artistique est majoritairement l'oeuvre d'Aurélie.</p>
        <p>
          Une charte colorée a été choisie pour l'application. Malgré le
          contexte émotionnel lourd des réfugiés, nous voulions proposer une peu
          de gaité et de légèreté, en ligne avec le côté "plaisir" des activités
          proposées.
        </p>
      </div>
      <Figure
        image={charte}
        alt="Charte graphique"
        caption="Charte graphique"
        sizes={half}
      />
    </div>

    <h3 id="ticket">Métaphore du ticket</h3>
    <div class="grid-2 split">
      <p>
        Le symbole duticket est l'élement central de l'application. C'est le
        sésame pour accéder aux activités proposées.
      </p>
      <Figure
        image={ticket}
        alt="Métaphore du ticket"
        caption="Métaphore du ticket"
        sizes={half}
      />
    </div>
  </Section>

  <!-- 05 -->
  <Section id="prototype" number={5} title="Prototype interactif final">
    <p>
      Le design a été réalisé sur Sketch, le prototype interactif avec Marvel.
    </p>
    <div class="grid-2">
      <Figure
        image={heroImage}
        alt="Maquette haute fidélité"
        caption="Maquette haute fidélité"
        sizes={half}
      />
      <Figure
        image={test}
        alt="Test du protype"
        caption="Test du protype"
        sizes={half}
      />
    </div>
    <p>
      Un lien vers le prototype interactif est disponible dans la section dédiée
      ci-dessous.
    </p>
  </Section>

  <!-- 06 -->
  <Section id="enseignements" number={6} title="Enseignements">
    <LearningsGrid columns={3}>
      <Learning n={1}>
        <p>
          Les informations collectées lors de la recherche terrain peuvent amener
          à invalider le brief de départ et conduire à un pivot du projet.
        </p>
      </Learning>
      <Learning n={2}>
        <p>
          Même quand le sujet touche émotionnellement, il est important de
          maintenir une rigueur méthodologique pour garantir la qualité du
          travail.
        </p>
      </Learning>
      <Learning n={3}>
        <p>
          Ce projet reste un "one shot" réalisé sur commande. Il n'a
          malheureusement pas vu le jour, Sia illustre le décalage entre un
          projet de design et la réalisation concrète.
        </p>
      </Learning>
    </LearningsGrid>
  </Section>

  <div class="appendix-grid">
    <LinkList
      links={[
        { label: "Prototype Interactif", href: "/Sia/index.html" },
        {
          label: "Dossier du projet - Gobelins",
          href: "https://designinteractif.gobelins.fr/wp-content/uploads/2017/07/UX2017_Thot_dossier.pdf",
        },
        {
          label: "Page du projet - Gobelins",
          href: "https://designinteractif.gobelins.fr/2017/07/09/sia/",
        },
        { label: "Ecole THoT", href: "https://thot-fle.fr/" },
        { label: "Centre Primo Levi", href: "https://primolevi.org/" },
        { label: "RFI Savoirs", href: "https://francaisfacile.rfi.fr/fr/" },
        { label: "Utopia 56", href: "https://utopia56.org/" },
      ]}
    />
    <Keywords>
      <span class="keyword">Design Thinking</span>
      <span class="keyword">Gobelins</span>
      <span class="keyword">Mobile</span>
      <span class="keyword">Sketch</span>
      <span class="keyword">Prototypage mobile</span>
      <span class="keyword">User Research</span>
      <span class="keyword">UX Design</span>
    </Keywords>
  </div>
</ProjectPersonal>

<style>
  .split {
    align-items: start;
    gap: 2rem;
  }
</style>
