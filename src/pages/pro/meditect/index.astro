---
import ProjectPro from "../../../layouts/ProjectPro.astro";
import Section from "../../../components/project/Section.astro";
import Card from "../../../components/project/Card.astro";
import Learnings from "../../../components/project/Learnings.astro";
import Keywords from "../../../components/project/Keywords.astro";
import Figure from "../../../components/project/Figure.astro";
import Quote from "../../../components/project/Quote.astro";
import Tabs from "../../../components/project/Tabs.astro";
import TabPanel from "../../../components/project/TabPanel.astro";
import FactGrid from "../../../components/project/FactGrid.astro";
import BeforeAfter from "../../../components/project/BeforeAfter.astro";
import LearningsGrid from "../../../components/project/LearningsGrid.astro";
import Learning from "../../../components/project/Learning.astro";
import LinkList from "../../../components/project/LinkList.astro";
import ProjectCard from "../../../components/ProjectCard.astro";
import heroImage from "../../../assets/pro/meditect/hero.png";
import segmentation from "../../../assets/pro/meditect/segmentation.png";
import mapping from "../../../assets/pro/meditect/mapping.png";
import roadmap from "../../../assets/pro/meditect/roadmap.png";
import sprint from "../../../assets/pro/meditect/sprint.png";
import medina from "../../../assets/pro/meditect/medina.jpg";
import belier from "../../../assets/pro/meditect/belier.jpg";
import depotsikensi from "../../../assets/pro/meditect/depot-sikensi.jpg";
import wireframes from "../../../assets/pro/meditect/wireframes.png";
import refold from "../../../assets/pro/meditect/ref-old.webp";
import refnew from "../../../assets/pro/meditect/ref-new.jpg";
import dsbtn from "../../../assets/pro/meditect/ds-button.png";
import dsshell from "../../../assets/pro/meditect/ds-shell.png";
import test from "../../../assets/pro/meditect/test-etiquettes.png";
import result from "../../../assets/pro/meditect/test-etiquettes-resultats.jpg";
import tracabilite from "../../../assets/pro/meditect/tracabilite.png";
import recthumb from "../../../assets/pro/meditect/rec-thumb.jpg";
import dsthumb from "../../../assets/pro/meditect/ds-thumbnail.jpg";

const half = "(min-width: 1200px) 27rem, (min-width: 768px) 45vw, 100vw";
const third = "(min-width: 1200px) 18rem, (min-width: 768px) 30vw, 100vw";
const panel = "(min-width: 1200px) 33rem, (min-width: 768px) 58vw, 100vw";

const chapters = [
  { id: "contexte", label: "Contexte" },
  { id: "strategie", label: "Stratégie & impact" },
  { id: "discovery", label: "Discovery" },
  { id: "design", label: "Product design" },
  { id: "cas", label: "Cas pratiques" },
  { id: "enseignements", label: "Enseignements" },
];
---

<ProjectPro
  title="Meditect"
  eyebrow="Healthtech · Afrique subsaharienne · 2021 — 2024"
  lede="Un logiciel de pharmacie SaaS, mobile first et résistant aux coupures — <em>conçu sur le terrain, avec les pharmaciens.</em>"
  meta={[
    { label: "Rôle", value: "Head of Product & Design" },
    { label: "Équipe", value: "~20 personnes, dont 3 en produit" },
    { label: "Durée", value: "4 ans · Comité de direction" },
    { label: "Site", value: "meditect.com", href: "https://www.meditect.com/" },
  ]}
  image={heroImage}
  imageAlt="Interface du logiciel de pharmacie Meditect : catalogue produits"
  keyFigures={[
    { value: "~5", unit: "%", label: "du marché cible en 24 mois, sur 7 pays" },
    { value: "2", label: "laboratoires pharmaceutiques signés comme partenaires" },
    { value: "+27k", label: "produits — 1er catalogue digital d'Afrique" },
  ]}
  chapters={chapters}
>
  <!-- 01 Contexte -->
  <Section id="contexte" number={1} title="Contexte">
    <p class="intro">
      Meditect est une startup healthtech initialement créée pour lutter contre
      les faux médicaments en Afrique subsaharienne.
    </p>
    <p>Recruté lors d'un pivot stratégique :</p>
    <ul class="list-arrow">
      <li>
        Digitaliser la santé en Afrique subsaharienne, dont les flux sont encore
        très papier-crayon.
      </li>
      <li>La data sera notre source de revenus.</li>
    </ul>
    <p>
      Dans un système de santé, le pharmacien est l'interlocuteur de toutes les
      parties prenantes, il en est le maillon central.
    </p>
    <Learnings variant="statement" caption="Le parti pris">
      <p>Nous commencerons par le pharmacien.</p>
    </Learnings>
  </Section>

  <!-- 02 Stratégie -->
  <Section id="strategie" number={2} title="Stratégie produit et impact">
    <div class="duo">
      <Card title="Challenge">
        <p>Plus de 50 pharmacies visitées, pour découvrir que :</p>
        <ul class="list-arrow">
          <li>
            <strong>Le besoin n°1</strong> est d'avoir un stock <em>propre</em>, pour
            toujours servir les patients et minimiser les pertes de trésorerie dues
            aux produits périmés.
          </li>
          <li>
            <strong>La concurrence</strong> propose des solutions <em>on-premise</em
            > qui ne tiennent pas face aux coupures régulières du courant électrique.
          </li>
        </ul>
      </Card>
      <Card title="Vision">
        <p>Un nouveau logiciel de pharmacie, SaaS, mobile first, pour :</p>
        <ul class="list-arrow">
          <li>Résister aux coupures de réseau (électrique et data).</li>
          <li>Permettre le pilotage à distance.</li>
          <li>
            S'appuyer sur un catalogue standardisé de produits, devenu notre <strong
              >asset stratégique</strong
            > pour produire la donnée sur plusieurs marchés.
          </li>
        </ul>
      </Card>
    </div>
    <Learnings variant="impact">
      <h3 class="label">Impact</h3>
      <ol>
        <li>
          <div>
            <strong>7 pays et ~5 % du marché cible en 24 mois</strong>, 1<sup
              >ères</sup
            > ventes en 12 mois.
          </div>
        </li>
        <li>
          <div>
            <strong>Partenariats avec 2 laboratoires</strong> pharmaceutiques majeurs.
          </div>
        </li>
        <li>
          <div>
            <strong>1<sup>er</sup> catalogue d'Afrique subsaharienne</strong> validé
            par des pharmaciens (+33k produits), monétisé auprès d'un acteur majeur
            de l'assurance santé privée (S&amp;P 500).
          </div>
        </li>
      </ol>
    </Learnings>

    <div class="grid-2 quotes">
      <Quote author="Matthieu Bagory" role="ex-CTO de Meditect">
        <p>
          Romuald a établi une solide culture produit basée sur la recherche
          utilisateur et des discussions exigeantes. Grâce à lui, nous avons
          réussi à pivoter d'une solution B2C de traçabilité à un système B2B de
          gestion de pharmacie. Un véritable team player et bâtisseur
          persévérant.
        </p>
      </Quote>
      <Quote author="Maxime Petit" role="ex-Développeur chez Meditect">
        <p>
          La vision claire de Romuald et sa constance ont permis à l'équipe de
          travailler avec cohérence. Il comprend les défis du développement, ce
          qui facilite la priorisation et rend nos interactions sur le design
          efficaces.
        </p>
      </Quote>
    </div>

    <Tabs variant="tabs" label="Artefacts de la stratégie produit">
      <TabPanel id="artefact-segmentation" title="Segmentation">
        <Figure
          slot="media"
          image={segmentation}
          alt="Segmentation commerciale"
          sizes={panel}
        />
        <span class="tag">Go-to-market</span>
        <h4>Segmentation commerciale</h4>
        <p>
          Les segments, issus de <em>Crossing the chasm</em> de G. A. Moore, ont permis
          de cartographier et d'ordonner les cibles commerciales.
        </p>
        <p>2 segments ajoutés pour le marché africain :</p>
        <ul class="list-arrow">
          <li>
            <strong>Dépôts de médicaments</strong> : a débloqué nos ventes après 12
            mois de développement.
          </li>
          <li>
            <strong>Pharmacies avec dépôts</strong> : pour anticiper un impact majeur
            sur le produit.
          </li>
        </ul>
      </TabPanel>
      <TabPanel id="artefact-mapping" title="Mapping">
        <Figure slot="media" image={mapping} alt="Tasks mapping" sizes={panel} />
        <span class="tag">Temps long</span>
        <h4>Mapping</h4>
        <p>
          Vision d'ensemble, en actualisation continue. Premier des 3 horizons de
          planification qui alignent stratégie et exécution.
        </p>
        <ol class="horizon" aria-label="Horizon 1 sur 3">
          <li class="on"></li><li></li><li></li>
        </ol>
      </TabPanel>
      <TabPanel id="artefact-roadmap" title="Roadmap">
        <Figure
          slot="media"
          image={roadmap}
          alt="Roadmap trimestrielle"
          sizes={panel}
        />
        <span class="tag">3 mois</span>
        <h4>Roadmap du trimestre</h4>
        <p>
          L'enveloppe fonctionnelle à 3 mois : ce que l'équipe s'engage à livrer,
          dérivé du mapping.
        </p>
        <ol class="horizon" aria-label="Horizon 2 sur 3">
          <li class="on"></li><li class="on"></li><li></li>
        </ol>
      </TabPanel>
      <TabPanel id="artefact-sprint" title="Sprint">
        <Figure slot="media" image={sprint} alt="Sprint" sizes={panel} />
        <span class="tag">Court terme</span>
        <h4>Sprint</h4>
        <p>L'exécution court terme, côté développement.</p>
        <ol class="horizon" aria-label="Horizon 3 sur 3">
          <li class="on"></li><li class="on"></li><li class="on"></li>
        </ol>
      </TabPanel>
    </Tabs>
  </Section>

  <!-- 03 Discovery -->
  <Section id="discovery" number={3} title="Discovery et process de recherche">
    <p class="intro">Priorité n°1 : comprendre le terrain.</p>
    <FactGrid
      items={[
        {
          label: "Recherche terrain",
          value:
            "<strong>+300</strong> comptes-rendus avec les pharmaciens, sur place ou via WhatsApp",
        },
        {
          label: "Multi-stakeholders",
          value:
            "<strong>+20</strong> échanges avec assurances, grossistes et laboratoires",
        },
        {
          label: "Documentation",
          value:
            "Tous les échanges retranscrits, parcours illustrés de photos in situ",
        },
        {
          label: "Recherche continue",
          value:
            "Pas une semaine sans échange avec au moins un·e pharmacien·ne",
        },
      ]}
    />
    <h3>Principes opérationnels</h3>
    <p>La recherche est organisée dans des bases de données Notion :</p>
    <ul class="list-arrow">
      <li>
        <strong>To Learn</strong> : nos questions, notées au fil de l'eau, marquées
        résolues quand la réponse arrive.
      </li>
      <li>
        <strong>Sessions</strong> : retranscriptions des échanges + photos, vidéos,
        scans de documents. Les sujets sont préparés en avance.
      </li>
    </ul>
    <p>
      Les informations collectées nourrissent la conception et la roadmap
      produit.
    </p>
    <div class="grid-3">
      <Figure
        image={medina}
        alt="Pharmacie Medina, Dakar, Sénégal"
        caption="Pharmacie Medina — Dakar, Sénégal"
        crop
        ratio="3/4"
        sizes={third}
      />
      <Figure
        image={belier}
        alt="Observation du processus de commande"
        caption="Observation du processus de commande"
        crop
        ratio="3/4"
        sizes={third}
      />
      <Figure
        image={depotsikensi}
        alt="Dépôt de médicaments à Sikensi, Côte d'Ivoire"
        caption="Dépôt de médicaments — Sikensi, Côte d'Ivoire"
        crop
        ratio="3/4"
        sizes={third}
      />
    </div>
  </Section>

  <!-- 04 Product design -->
  <Section id="design" number={4} title="Product design">
    <h3>Wireframes</h3>
    <p>
      En Afrique, les personnes au comptoir ne sont pas forcément formées au
      métier de la pharmacie. Avec nos pharmaciens internes, nous avons conçu un
      logiciel radicalement simplifié comparé à l'état de l'art.
    </p>
    <ul class="list-arrow">
      <li>
        <strong>Navigation principale</strong> : passer de l'espace de vente aux commandes,
        puis à la gestion financière.
      </li>
      <li>
        <strong>Navigation secondaire</strong> : spécialiser le travail dans un espace.
        Ex. commandes : préparer, envoyer, réceptionner.
      </li>
    </ul>
    <Figure
      image={wireframes}
      alt="Wireframes du logiciel"
      caption="Un logiciel aussi simple à prendre en main que possible, pour masquer la complexité du métier."
    />

    <h3>Charte de couleurs — une fausse bonne idée</h3>
    <p>
      Nous avions imaginé une charte inspirée des couleurs africaines : le rouge
      de la terre et le vert de la végétation, testée sur le prototype du
      catalogue.
    </p>
    <BeforeAfter
      before={{
        image: refold,
        alt: "Prototype du catalogue avec la charte africaine",
        label: "Prototype rejeté",
      }}
      after={{
        image: refnew,
        alt: "Catalogue en production, bleu et vert",
        label: "En production",
      }}
    >
      <Fragment slot="note">
        <strong>Ce qu'on a appris :</strong> les pharmaciens voulaient un outil « pro
        », pas un marqueur culturel. Nous avons basculé vers le bleu et le vert, couleurs
        classiques de la santé en Occident.
      </Fragment>
    </BeforeAfter>

    <h3>Design system</h3>
    <p>
      Après un benchmark de librairies UI, nous avons choisi <a
        href="https://www.chakra-ui.com/">Chakra UI</a
      > et construit notre design system selon les principes d'Atomic Design, en s'appuyant
      sur les composants, variables, variants et l'auto-layout de Figma. <strong
        >~120 composants</strong
      >, tous disponibles en version écran large et mobile.
    </p>
    <div class="grid-2">
      <Figure
        image={dsbtn}
        alt="Design system : boutons"
        caption="Boutons"
        sizes={half}
      />
      <Figure
        image={dsshell}
        alt="Design system : shell"
        caption="Shell applicatif"
        sizes={half}
      />
    </div>

    <h3>Tests utilisateurs à 6 500 km</h3>
    <p>
      Ma présence sur le terrain était consacrée à la discovery et aux
      commerciaux. Pour les tests, nous nous sommes inspirés de Doctolib :
    </p>
    <ol class="numbered">
      <li>Vidéo d'exécution du prototype.</li>
      <li>
        Page Notion avec la vidéo et un questionnaire d'évaluation (scores de 1
        à 10 sur la compréhension et la simplicité perçue, + commentaires
        libres).
      </li>
      <li>Envoi du lien aux pharmaciens via WhatsApp.</li>
    </ol>
    <div class="grid-2">
      <Figure
        image={test}
        alt="Page de tests pour l'impression des étiquettes"
        caption="Page de test — impression des étiquettes"
        sizes={half}
      />
      <Figure
        image={result}
        alt="Résultats des tests pour l'impression des étiquettes"
        caption="Résultats quantifiés"
        sizes={half}
      />
    </div>
    <p>
      Cette approche asynchrone a effacé une partie de la distance : des retours
      quantifiés pour valider nos concepts et itérer (modèle d'étiquette, par
      exemple).
    </p>

    <h3>Traçabilité</h3>
    <p>Chaque fichier de design est organisé ainsi :</p>
    <ul class="list-arrow">
      <li>
        <strong>components</strong> : composants issus du design system, spécialisés
        pour ce fichier.
      </li>
      <li>
        <strong>[YYQX] sujet</strong> : une page par trimestre et par sujet. Ex. <em
          >[23Q1] Éditer un BL des produits de la vente</em
        >.
      </li>
      <li>
        <strong>Vignette de traçabilité</strong> : un lien vers le ticket concerné,
        et vice versa.
      </li>
    </ul>
    <Figure
      image={tracabilite}
      alt="Traçabilité Figma/Notion"
      caption="Traçabilité Figma ↔ Notion"
    />
  </Section>

  <!-- 05 Cas pratiques -->
  <Section id="cas" number={5} title="Cas pratiques">
    <div class="grid-2 cases">
      <ProjectCard
        title="Design system"
        description="Accélérer la conception du produit et renforcer la cohérence UX et UI."
        link="/pro/meditect/designsystem"
        image={dsthumb}
        metric="120 génériques · +100 spécialisés"
        layout="stack"
        headingLevel="h3"
      />
      <ProjectCard
        title="Réception de commande"
        description="Faciliter l'alimentation du stock, une fonctionnalité exécutée plusieurs fois par jour."
        link="/pro/meditect/receiving"
        image={recthumb}
        metric="Fonctionnalité 0 → 1"
        layout="stack"
        headingLevel="h3"
      />
    </div>
    <div class="grid-3 quotes voices">
      <Quote author="Dr Mansour" role="Yaoundé, Cameroun">
        <p>
          Votre produit, il est quand même révolutionnaire si on compare à ce
          qui existe chez nous.
        </p>
      </Quote>
      <Quote author="Dr Eteki" role="Douala, Cameroun">
        <p>…votre logiciel est quand même bien pensé…</p>
      </Quote>
      <Quote author="Nadia" role="Commerciale Meditect">
        <p>
          Les clients sont plutôt satisfaits, la preuve : déjà plusieurs
          recommandations !
        </p>
      </Quote>
    </div>
  </Section>

  <!-- 06 Enseignements -->
  <Section id="enseignements" number={6} title="Enseignements clés">
    <LearningsGrid>
      <Learning n={1} title="Discovery terrain = fondation produit">
        <p>
          Les heures de terrain, sur place ou sur WhatsApp, ont révélé ce qu'un
          brief rapide n'aurait jamais montré. Sans cette immersion, le produit
          n'aurait probablement pas été celui-là.
        </p>
      </Learning>
      <Learning n={2} title="Le product market fit prime">
        <p>
          Avec des ressources limitées, mieux vaut un produit incomplet qui
          fonctionne. Décision assumée : abandonner Storybook et reporter
          l'optimisation UX mobile pour valider le marché d'abord.
        </p>
      </Learning>
      <Learning n={3} title="Le design system, levier de passage à l'échelle">
        <p>
          Avec +120 composants et une équipe de 4 personnes, nous avons conçu un
          ERP complet et cohérent. En contexte startup, un vrai « game changer ».
        </p>
      </Learning>
      <Learning n={4} title="Pragmatisme = trouver des solutions">
        <p>
          À 6 500 km, en startup, il faut avancer avec ce qu'on a — comme les
          tests sur vidéo.
        </p>
      </Learning>
    </LearningsGrid>
  </Section>

  <div class="appendix-grid">
    <LinkList
      links={[
        {
          label: "Accueil de l'application pharmacien",
          href: "https://pharmacie.meditect.com/",
        },
        {
          label: "User research : prototype d'impression des étiquettes",
          href: "https://tisserand.notion.site/Impression-des-tiquettes-1c8000ee8f6f80fb9be7e2f1105cfb51",
        },
        {
          label: "Aide de l'application pharmacien",
          href: "https://meditect.notion.site/Aide-du-LGO-Meditect-75c8777c4474403bad7fc9ca07032033",
        },
        { label: "Site de Meditect", href: "https://www.meditect.com/" },
      ]}
    />
    <Keywords>
      <span class="keyword">Discovery</span>
      <span class="keyword">User Research</span>
      <span class="keyword">Design System</span>
      <span class="keyword">UX Design</span>
      <span class="keyword">Design Ops</span>
      <span class="keyword">Product Ops</span>
      <span class="keyword">OKRs</span>
      <span class="keyword">SaaS</span>
      <span class="keyword">Healthtech</span>
      <span class="keyword">Figma</span>
      <span class="keyword">Notion</span>
      <span class="keyword">React</span>
      <span class="keyword">Storybook</span>
    </Keywords>
  </div>
</ProjectPro>

<style>
  .quotes {
    gap: 2.5rem;
    margin-top: 3.5rem;
  }

  .voices {
    gap: 1.75rem;
  }

  .voices :global(blockquote) {
    font-size: 1.2rem;
  }

  .cases {
    margin-top: 0;
  }

  /* Planning horizon: 3 bars, filled up to the current one */
  .horizon {
    list-style: none;
    display: flex;
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
  }

  .horizon li {
    flex: 1;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
  }

  .horizon li.on {
    background: var(--accent-deco);
  }
</style>
