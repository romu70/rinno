---
import ProjectPro from "../../layouts/ProjectPro.astro";
import Section from "../../components/project/Section.astro";
import Card from "../../components/project/Card.astro";
import Learnings from "../../components/project/Learnings.astro";
import Keywords from "../../components/project/Keywords.astro";
import Figure from "../../components/project/Figure.astro";
import Tabs from "../../components/project/Tabs.astro";
import TabPanel from "../../components/project/TabPanel.astro";
import FactGrid from "../../components/project/FactGrid.astro";
import Options from "../../components/project/Options.astro";
import Option from "../../components/project/Option.astro";
import CaseBlock from "../../components/project/CaseBlock.astro";
import Outcomes from "../../components/project/Outcomes.astro";
import LearningsGrid from "../../components/project/LearningsGrid.astro";
import Learning from "../../components/project/Learning.astro";
import heroImage from "../../assets/pro/novyspec/hero.png";
import empathy from "../../assets/pro/novyspec/empathy-map.png";
import team from "../../assets/pro/novyspec/persona-1.jpeg";
import persona from "../../assets/pro/novyspec/persona.png";
import postit from "../../assets/pro/novyspec/persona-4.jpeg";
import ds from "../../assets/pro/novyspec/ds.png";
import userflow from "../../assets/pro/novyspec/navigation.png";
import task from "../../assets/pro/novyspec/task.png";
import taskfinal from "../../assets/pro/novyspec/task-final.png";
import wireframes from "../../assets/pro/novyspec/wireframes.png";
import ui from "../../assets/pro/novyspec/ui.png";
import sixtoone from "../../assets/pro/novyspec/6-to-1.jpg";
import editor from "../../assets/pro/novyspec/editor.jpg";
import epi from "../../assets/pro/novyspec/epi.png";
import clim1 from "../../assets/pro/novyspec/clim1.jpg";
import clim2 from "../../assets/pro/novyspec/clim2.jpg";
import climuj from "../../assets/pro/novyspec/clim-uj.png";
import netagro from "../../assets/pro/novyspec/netagro.png";
import netagro2 from "../../assets/pro/novyspec/netagro2.jpg";

// Image sizes for figures in a 2-column grid / in a step panel
const half = "(min-width: 1200px) 27rem, (min-width: 768px) 45vw, 100vw";
const panel = "(min-width: 1200px) 32rem, (min-width: 768px) 55vw, 100vw";

const chapters = [
  { id: "contexte", label: "Contexte" },
  { id: "enjeux", label: "Enjeux" },
  {
    id: "realisations",
    label: "Réalisations",
    children: [
      { id: "persona", label: "Proto-persona" },
      { id: "ui", label: "UI & design system" },
      { id: "app", label: "App d'inspection" },
      { id: "formulaire", label: "Concepteur de formulaire" },
      { id: "epi", label: "Étude EPI" },
    ],
  },
  {
    id: "discovery",
    label: "Discovery",
    children: [
      { id: "climatiseurs", label: "Climatiseurs" },
      { id: "agro", label: "Agroalimentaire" },
    ],
  },
  { id: "bilan", label: "Succès & échecs" },
  { id: "enseignements", label: "Enseignements" },
];
---

<ProjectPro
  title="Novyspec"
  eyebrow="Industrie · Inspection terrain · 2017 — 2018"
  lede="Une application d'inspection industrielle conçue à partir d'une feuille blanche — <em>et mon pivot de la tech vers le produit et le design.</em>"
  meta={[
    { label: "Rôle", value: "Product Manager & Designer" },
    { label: "Équipe", value: "10 personnes" },
    { label: "Durée", value: "2 ans" },
    { label: "Issue", value: "Non commercialisé" },
  ]}
  image={heroImage}
  imageAlt="Maquettes de l'application d'inspection Novyspec"
  keyFigures={[
    { value: "4", label: "verticales métier qualifiées" },
    { value: "PWA", label: "conçue de A à Z" },
    { value: "Tech → UX", label: "transformation de l'équipe" },
  ]}
  chapters={chapters}
>
  <!-- 01 -->
  <Section id="contexte" number={1} title="Contexte">
    <p class="intro">
      Après plusieurs années dans des fonctions techniques, Novyspec m'accorde
      sa confiance pour mener la conception de sa nouvelle application
      d'inspection industrielle, en parallèle de ma formation UX Design aux
      Gobelins.
    </p>
    <p>
      L'équipe venait d'un produit similaire, mais d'une technologie obsolète et
      sans approche centrée sur l'utilisateur. Nous devions développer une
      nouvelle solution, en repartant d'une feuille blanche.
    </p>
    <Learnings variant="statement" caption="Pourquoi ce projet compte">
      <p>
        Ce produit n'a pas vu le jour, mais il m'a donné les fondations pour
        réussir ensuite chez Smart-Rx et Meditect.
      </p>
    </Learnings>
  </Section>

  <!-- 02 -->
  <Section id="enjeux" number={2} title="Enjeux">
    <div class="duo">
      <Card title="Structuration méthodologique">
        <p>
          Mettre en place la bonne méthodologie et les bons outils pour
          concevoir le produit avec une approche produit et design rigoureuse,
          au sein d'une équipe très orientée tech.
        </p>
      </Card>
      <Card title="Conception UX">
        <p>
          Concevoir une application d'inspection industrielle moderne, pensée
          pour les entreprises, et capable d'interagir avec son écosystème
          d'objets connectés.
        </p>
      </Card>
    </div>
  </Section>

  <!-- 03 -->
  <Section id="realisations" number={3} title="Réalisations produit">
    <h3 id="persona">Recherche &amp; proto-persona</h3>
    <p>
      L'équipe ayant déjà réalisé une solution d'inspection industrielle, mon
      objectif était de l'aider à formaliser la connaissance utilisateur
      acquise. Pour que tout le monde soit au même niveau, et parce que nous
      n'avions pas accès aux utilisateurs au démarrage du projet.
    </p>
    <div class="grid-2">
      <Figure
        image={team}
        alt="L'équipe en atelier persona"
        caption="L'équipe en atelier persona"
        crop
        ratio="4/3"
        sizes={half}
      />
      <Figure
        image={persona}
        alt="Le proto-persona finalisé"
        caption="Le proto-persona finalisé"
        crop
        ratio="4/3"
        position="top"
        sizes={half}
      />
    </div>
    <p>
      Un atelier de 2 heures nous a permis de consolider la connaissance acquise
      pendant plusieurs années.
    </p>

    <Tabs variant="steps" label="L'atelier persona, étape par étape">
      <TabPanel id="persona-1" step="Étape 1" title="Empathy map">
        <Figure
          slot="media"
          image={empathy}
          alt="Modèle d'empathy map utilisé"
          pad
          sizes={panel}
        />
        <p>
          Un modèle d'empathy map a été distribué à chaque membre de l'équipe,
          ainsi que des post-it.
        </p>
      </TabPanel>
      <TabPanel id="persona-2" step="Étape 2" title="Mise en commun">
        <Figure
          slot="media"
          image={postit}
          alt="Regroupement des post-it du persona"
          crop
          ratio="4/3"
          sizes={panel}
        />
        <p>
          La mise en commun des post-it a permis de regrouper les informations
          et de définir notre persona « inspecteur ».
        </p>
      </TabPanel>
    </Tabs>

    <h3 id="ui">UI &amp; design system</h3>
    <p>
      <strong>Choix d'une librairie UI.</strong> Nos critères : compatible ReactJs,
      maintenue, communauté active, documentation claire et personnalisable.
      Candidates : <a href="https://semantic-ui.com/">Semantic UI</a>, <a href="https://material.io/">Material UI</a> et <a href="https://ant.design/">Ant Design</a>.
      Notre choix : <strong>Ant Design</strong>.
    </p>
    <p>
      <strong>Design system :</strong> un design system préliminaire, mené en parallèle
      de la conception du produit, sur la base de la couleur orange du logo de Novyspec.
    </p>
    <Figure
      image={ds}
      alt="Design system préliminaire"
      caption="Design system préliminaire"
      dark
    />

    <h3 id="app">Conception de l'application d'inspection</h3>
    <p>
      L'application s'appuie sur la connaissance accumulée par l'équipe avec la
      solution précédente. Le userflow présente le fonctionnement général ; les
      écrans vides accueillent les formulaires métiers.
    </p>
    <p>
      La validation d'une tâche se fait en 2 temps : <em>Complete</em>, puis <em
        >Validate</em
      >. Cette <strong>friction</strong> volontaire évite les erreurs de manipulation
      induites par les interfaces tactiles.
    </p>
    <Figure
      image={userflow}
      alt="Userflow général de l'application"
      caption="Userflow général"
      dark
    />

    <Tabs variant="steps" label="De l'atelier au design final">
      <TabPanel id="tache-1" step="01" title="Atelier tâche">
        <Figure
          slot="media"
          image={task}
          alt="Atelier de conception d'une tâche avec des éléments de UI papier"
          crop
          ratio="4/3"
          sizes={panel}
        />
        <p>
          Seuls les formulaires d'inspection sont spécifiques à un métier. J'ai
          sollicité des utilisateurs « proxies » pour concevoir une tâche telle
          qu'elle apparaît dans l'application.
        </p>
        <p>
          Avec des éléments de UI papier, ils proposaient ce qui faisait sens
          pour eux dans une « tâche ».
        </p>
      </TabPanel>
      <TabPanel id="tache-2" step="02" title="Tâche finalisée">
        <Figure
          slot="media"
          image={taskfinal}
          alt="Design finalisé d'une tâche"
          pad
          sizes={panel}
        />
        <p>
          Après mise en commun des propositions, j'avais les éléments
          nécessaires pour concevoir une tâche.
        </p>
      </TabPanel>
      <TabPanel id="tache-3" step="03" title="Wireframes">
        <Figure
          slot="media"
          image={wireframes}
          alt="Wireframes de l'application"
          pad
          sizes={panel}
        />
        <p>
          Les wireframes ont nourri la réflexion sur le parcours : ici la vue
          des tâches et une tâche ouverte.
        </p>
        <p>
          Ils ont été animés dans un prototype InVision, et testés avec des
          utilisateurs « proxies ».
        </p>
      </TabPanel>
      <TabPanel id="tache-4" step="04" title="UI finale">
        <Figure
          slot="media"
          image={ui}
          alt="UI finalisée"
          pad
          sizes={panel}
        />
        <p>
          Les résultats des tests des wireframes ont été analysés et intégrés
          dans la conception finale.
        </p>
      </TabPanel>
    </Tabs>

    <h3 id="formulaire">Conception du concepteur de formulaire</h3>
    <p>
      Le concepteur de formulaire définit le contenu des campagnes d'inspection.
      Il n'est utilisé qu'au bureau.
    </p>
    <p>
      Une session d'idéation selon le modèle 6-to-1 a dégagé des pistes pour le
      design final des écrans.
    </p>
    <div class="grid-2">
      <Figure
        image={sixtoone}
        alt="Idéation 6-to-1"
        caption="Idéation 6-to-1"
        crop
        ratio="4/3"
        sizes={half}
      />
      <Figure
        image={editor}
        alt="Éditeur de formulaire"
        caption="Éditeur de formulaire"
        crop
        ratio="4/3"
        position="top"
        sizes={half}
      />
    </div>

    <h3 id="epi">Étude de la détection du port des EPI</h3>
    <p>
      Une étude d'environ 3 mois, menée dans le cadre de mon mémoire
      professionnel aux Gobelins.
    </p>
    <FactGrid
      items={[
        {
          label: "Enjeu business",
          value:
            "Si notre produit détecte le port des EPI (Équipements de Protection Individuelle), nous contribuons à faire baisser la prime d'assurance de nos clients.",
        },
        {
          label: "Méthodologie",
          value:
            "Étudier différents scénarios pour intégrer cette détection dans l'application d'inspection.",
        },
      ]}
    />
    <Options>
      <Option
        level="Scénario minimal"
        title="Balayage visuel"
        result="Manipulations de la tablette inconfortables pour les testeurs."
      >
        <p>Balayage visuel du corps avec ses EPI, et analyse d'image.</p>
      </Option>
      <Option
        level="Scénario intermédiaire"
        title="Capture de QR-Code"
        result="Le plus simple à mettre en œuvre. La difficulté se reporte sur la pose de QR-Codes robustes, non testée."
        badge="Le plus simple"
        highlight
      >
        <p>Capture de QR-Codes apposés sur les EPI.</p>
      </Option>
      <Option
        level="Scénario maximal"
        title="EPI connectés (BLE)"
        result="Marché balbutiant : quelques chaussures prototypes, insuffisantes pour les exigences de sécurité."
      >
        <p>Détection d'EPI connectés en Bluetooth Low Energy.</p>
      </Option>
    </Options>
    <Figure
      image={epi}
      alt="Étude de la détection des EPI via QR-Code"
      caption="Scénario intermédiaire : détection des EPI via QR-Code"
    />
  </Section>

  <!-- 04 -->
  <Section id="discovery" number={4} title="Discovery multi-verticales">
    <p class="intro">
      Une phase d'exploration des opportunités de marché : plusieurs verticales
      métier étudiées, dont deux présentées ici.
    </p>

    <CaseBlock
      kicker="Verticale 1"
      title="Contrôle qualité de climatiseurs industriels"
      id="climatiseurs"
    >
      <p>
        J'ai suivi pendant une matinée Ludovic, chargé de vérifier la conformité
        des climatiseurs industriels en sortie de chaîne de fabrication.
      </p>
      <div class="grid-2">
        <Figure
          image={clim1}
          alt="Vérification des circuits hydrauliques"
          caption="Vérification des circuits hydrauliques"
          crop
          ratio="3/4"
          sizes={half}
        />
        <Figure
          image={clim2}
          alt="Vérification des circuits électroniques"
          caption="Vérification des circuits électroniques"
          crop
          ratio="3/4"
          sizes={half}
        />
      </div>
      <p>
        Avec les informations collectées, j'ai modélisé le user journey de
        Ludovic, et présenté ce parcours à l'équipe.
      </p>
      <Figure
        image={climuj}
        alt="User journey de Ludovic"
        caption="User journey de Ludovic"
      />
      <Learnings variant="end">
        <p>
          <strong>Fin du projet.</strong> Notre produit aurait pu grandement améliorer
          l'efficacité du travail de Ludovic, mais aucun budget n'était disponible.
        </p>
      </Learnings>
    </CaseBlock>

    <CaseBlock
      kicker="Verticale 2"
      title="Contrôle du nettoyage dans une usine agroalimentaire"
      id="agro"
    >
      <p>
        Avec une consultante experte de l'usine, nous devions proposer une
        solution pour contrôler la prestation de nettoyage, qui change
        (fréquence, opérations, produits) au gré de la production.
      </p>
      <Tabs variant="steps" label="Deux étapes">
        <TabPanel id="agro-1" step="Étape 1" title="Workflow">
          <Figure
            slot="media"
            image={netagro}
            alt="Modélisation du nettoyage de l'usine agroalimentaire"
            sizes={panel}
          />
          <p>
            Modélisation des enjeux du nettoyage dans l'usine. Plusieurs
            échanges avec la consultante ont été nécessaires pour comprendre les
            flux d'information et les besoins de l'entreprise.
          </p>
        </TabPanel>
        <TabPanel id="agro-2" step="Étape 2" title="Idéation">
          <Figure
            slot="media"
            image={netagro2}
            alt="Idéation de scénario avec bracelets NFC"
            crop
            ratio="3/4"
            sizes={panel}
          />
          <p>
            Une tablette dans chaque salle à nettoyer, un bracelet NFC pour
            chaque opérateur :
          </p>
          <ol class="numbered">
            <li>
              En entrant, l'opérateur passe son bracelet devant la tablette.
            </li>
            <li>
              La tablette l'identifie et affiche les instructions de nettoyage.
            </li>
            <li>Il n'a plus qu'à nettoyer selon les instructions.</li>
          </ol>
        </TabPanel>
      </Tabs>
      <Learnings variant="end">
        <p>
          <strong>Fin du projet.</strong> L'usine a refusé ce scénario par crainte
          d'une contamination bactérienne induite par l'introduction de tablettes
          dans les salles à nettoyer.
        </p>
      </Learnings>
    </CaseBlock>
  </Section>

  <!-- 05 -->
  <Section id="bilan" number={5} title="Succès & échecs">
    <Outcomes>
      <Fragment slot="yes">
        <li>
          <strong>Design system</strong> conçu et intégré dans tous les designs de
          l'application.
        </li>
        <li>
          <strong>Application conçue de A à Z</strong> avec une méthodologie aussi
          rigoureuse que le contexte le permettait.
        </li>
        <li><strong>4 verticales métier</strong> explorées et qualifiées.</li>
      </Fragment>
      <Fragment slot="no">
        <li>
          <strong>Application partiellement développée</strong>, jamais mise en
          production.
        </li>
        <li>
          <strong>Échec business</strong> : product market fit non trouvé, aucun
          contrat signé.
        </li>
      </Fragment>
    </Outcomes>
  </Section>

  <!-- 06 -->
  <Section id="enseignements" number={6} title="Enseignements clés">
    <LearningsGrid columns={3}>
      <Learning n={1} title="Rigueur méthodologique">
        <p>Appliquée ensuite avec succès chez Smart-Rx et Meditect.</p>
      </Learning>
      <Learning n={2} title="Travailler dans l'incertitude">
        <p>Une capacité qui m'a beaucoup servi chez Meditect.</p>
      </Learning>
      <Learning n={3} title="Étudier le marché d'abord">
        <p>Avant de passer à la technique.</p>
      </Learning>
    </LearningsGrid>
    <p class="after-grid">
      <strong>Pourquoi l'échec ?</strong> Une équipe déjà expérimentée sur une solution
      de niche proche pouvait faire croire que cette offre répondait à un problème.
      Les verticales explorées avaient de réels besoins, mais pas le budget pour
      lancer le produit.
    </p>
    <Learnings variant="statement" caption="La leçon">
      <p>
        La discovery ne sert pas qu'à concevoir : elle sert d'abord à explorer
        s'il y a un marché pour résoudre le problème identifié.
      </p>
    </Learnings>
  </Section>

  <Keywords>
    <span class="keyword">User Research</span>
    <span class="keyword">UX Design</span>
    <span class="keyword">Design System</span>
    <span class="keyword">Ant Design</span>
    <span class="keyword">React Js</span>
    <span class="keyword">Prototypage mobile</span>
    <span class="keyword">Mobile</span>
    <span class="keyword">Sketch</span>
    <span class="keyword">Gobelins</span>
  </Keywords>
</ProjectPro>

<style>
  .after-grid {
    margin-top: 2rem;
  }
</style>
