---
// Breadcrumbs component with structured data
interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Add home as the first item if not present
const breadcrumbItems =
  items[0]?.name === "Accueil"
    ? items
    : [{ name: "Accueil", url: "/" }, ...items];

// Generate structured data
const structuredData = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: `https://romu70.github.io${item.url}`,
  })),
};
---

<nav aria-label="Fil d'Ariane" class="breadcrumbs">
  <ol>
    {
      breadcrumbItems.map((item, index) => (
        <li>
          {index < breadcrumbItems.length - 1 ? (
            <a href={item.url}>{item.name}</a>
          ) : (
            <span aria-current="page">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

<style>
  .breadcrumbs {
    margin-bottom: 2.5rem;
  }

  ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    color: var(--muted);
  }

  li + li::before {
    content: "/";
    margin-right: 0.5rem;
    color: #a3a3b8;
  }

  a {
    color: var(--muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  [aria-current="page"] {
    color: var(--ink);
  }

  @media (min-width: 768px) {
    .breadcrumbs {
      margin-bottom: 3rem;
    }

    ol {
      font-size: 0.75rem;
    }
  }
</style>
