---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// Project card: image, title, year, description, optional metric and CTA.
interface Props {
  title: string;
  year?: string;
  description: string;
  link?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** Key metric or status line (alias: bottomText) */
  metric?: string;
  bottomText?: string;
  /** Call-to-action label shown when the card is a link */
  cta?: string;
  category?: "pro" | "perso";
  accent?: "indigo" | "coral";
  /** "row" (image left, landing pages) or "stack" (image on top, grids) */
  layout?: "row" | "stack";
  headingLevel?: "h2" | "h3";
  /** "contain" shows the whole image inset on white (logos) */
  fit?: "cover" | "contain";
  /** Background behind the image, e.g. "#303030" for a dark screenshot */
  imageBg?: string;
  /** CSS object-position of the image, e.g. "top" */
  imagePosition?: string;
  /** Role of AI in the project: level chip + short detail */
  ai?: { level: string; detail?: string; none?: boolean };
}

const {
  title,
  year,
  description,
  link,
  image,
  imageAlt,
  metric,
  bottomText,
  cta = "Deep-dive →",
  category,
  accent,
  layout = "row",
  headingLevel = "h2",
  fit = "cover",
  imageBg,
  imagePosition,
  ai,
} = Astro.props;

const line = metric ?? bottomText;
const isClickable = !!link;
const Tag = isClickable ? "a" : "div";
const Heading = headingLevel;
const accentStyle =
  accent === "coral"
    ? "--accent: #b8344f; --accent-deco: #cc4060; --accent-soft: #fbecef"
    : accent === "indigo"
      ? "--accent: #4040cc; --accent-deco: #4040cc; --accent-soft: #eeeefb"
      : undefined;
---

<Tag
  href={isClickable ? link : undefined}
  class:list={["card", layout, { clickable: isClickable }]}
  style={accentStyle}
>
  <div
    class:list={["card-img", { contain: fit === "contain" }]}
    style={imageBg ? `background: ${imageBg}` : undefined}
  >
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? ""}
          widths={[320, 480, 720].filter((w) => w <= image.width)}
          sizes={
            layout === "stack"
              ? "(min-width: 768px) 27rem, 100vw"
              : "(min-width: 768px) 16rem, 100vw"
          }
          format="webp"
          quality={80}
          style={imagePosition ? `object-position: ${imagePosition}` : undefined}
        />
      ) : (
        <div class="placeholder" aria-hidden="true">
          <span>{title.charAt(0)}</span>
        </div>
      )
    }
    {
      category && (
        <span class:list={["category", category]}>
          {category === "pro" ? "Pro" : "Perso"}
        </span>
      )
    }
  </div>
  <div class="card-body">
    <div class="card-head">
      <Heading>{title}</Heading>
      {year && <span class="badge">{year}</span>}
    </div>
    <p class="description">{description}</p>
    {
      ai && (
        <p class:list={["ai", { "ai-none": ai.none }]}>
          <span class="ai-level">{ai.level}</span>
          {ai.detail && <span class="ai-detail">{ai.detail}</span>}
        </p>
      )
    }
    {
      (line || isClickable) && (
        <div class="card-foot">
          {line && <span class="metric">{line}</span>}
          {isClickable && <span class="go">{cta}</span>}
        </div>
      )
    }
  </div>
</Tag>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition:
      border-color 0.25s,
      transform 0.25s,
      box-shadow 0.25s;
  }

  .card.clickable:hover {
    color: inherit;
    border-color: var(--accent-deco);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px -16px color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .card.clickable:hover h2,
  .card.clickable:hover h3 {
    color: var(--accent);
  }

  .card-img {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--soft);
    border-bottom: 1px solid var(--line);
    overflow: hidden;
  }

  .card-img :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-img.contain {
    background: var(--surface);
  }

  .card-img.contain :global(img) {
    object-fit: contain;
    padding: 12%;
  }

  .placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--body), var(--line));
  }

  .placeholder span {
    font-family: var(--sans);
    font-size: 3rem;
    font-weight: 600;
    color: var(--paper);
  }

  .category {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .card-body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    min-width: 0;
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }

  h2,
  h3 {
    margin: 0;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    transition: color 0.2s;
  }

  .description {
    font-family: var(--serif);
    font-size: var(--text-sm);
    margin: 0;
  }

  .ai {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.6rem;
    margin: 0.2rem 0 0;
    font-family: var(--sans);
    font-size: 0.8rem;
  }

  .ai-level {
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .ai-none .ai-level {
    background: var(--soft);
    color: var(--muted);
  }

  .ai-detail {
    color: var(--muted);
  }

  .card-foot {
    margin-top: auto;
    padding-top: 0.6rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .metric {
    color: var(--muted);
  }

  .go {
    color: var(--accent);
    white-space: nowrap;
    margin-left: auto;
  }

  @media (min-width: 768px) {
    .card.row {
      flex-direction: row;
    }

    .card.row .card-img {
      flex: 0 0 16rem;
      aspect-ratio: auto;
      min-height: 13rem;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }

    .card-body {
      padding: 1.75rem;
    }

    .card-foot {
      font-size: 0.75rem;
    }

    .category {
      font-size: 0.65rem;
    }
  }

  @media (min-width: 1440px) {
    .card.row .card-img {
      flex-basis: 18rem;
    }
  }
</style>
