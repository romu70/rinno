---
// Column: a content block with an optional title.
// Several Columns in a Section sit side by side from 768px.
// layout="wide-narrow" (≈ 2.2fr / 1fr) puts a desktop screenshot next to a
// mobile one when its children are two figures.
interface Props {
  title?: string;
  fullWidth?: boolean;
  alignWithContent?: boolean;
  headingLevel?: "h2" | "h3" | "h4";
  layout?: "stack" | "wide-narrow";
}

const {
  title,
  fullWidth = false,
  alignWithContent = false,
  headingLevel = "h3",
  layout = "stack",
} = Astro.props;
const HeadingTag = headingLevel;
// Only apply align-with-content class when there's no title
const shouldAlignContent = alignWithContent && !title;
---

<div
  class:list={[
    "column",
    {
      "full-width": fullWidth,
      "align-with-content": shouldAlignContent,
    },
  ]}
>
  {title && <HeadingTag>{title}</HeadingTag>}
  <div class:list={["column-content", layout]}>
    <slot />
  </div>
</div>

<style>
  .column {
    min-width: 0;
  }

  .column.full-width {
    flex: 1 1 100% !important;
  }

  .column > h2,
  .column > h3,
  .column > h4 {
    margin-top: 0;
  }

  .column-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    align-content: start;
  }

  .column-content > :global(*) {
    margin-top: 0;
  }

  @media (min-width: 768px) {
    .column.align-with-content > .column-content {
      /* Align with a sibling column's content (below its heading) */
      padding-top: 3.25rem;
    }

    .column-content.wide-narrow {
      grid-template-columns: minmax(0, 2.2fr) minmax(0, 1fr);
      gap: 1.25rem;
      align-items: end;
    }
  }
</style>
