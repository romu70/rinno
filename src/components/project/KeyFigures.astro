---
// Key figures under the hero. Renders nothing without figures.
export interface KeyFigure {
  value: string;
  label: string;
  /** Small suffix shown in the accent colour, e.g. "%" */
  unit?: string;
}

interface Props {
  figures?: KeyFigure[];
}

const { figures = [] } = Astro.props;
---

{
  figures.length > 0 && (
    <div class="figures" style={`--count: ${figures.length}`}>
      {figures.map((f) => (
        <div class="kf">
          <p class="kf-n">
            {f.value}
            {f.unit && <small>{f.unit}</small>}
          </p>
          <p class="kf-l">{f.label}</p>
        </div>
      ))}
    </div>
  )
}

<style>
  .figures {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border-bottom: 1px solid var(--line);
  }

  .kf {
    padding: 1.5rem 0;
    min-width: 0;
  }

  .kf + .kf {
    border-top: 1px solid var(--line);
  }

  .kf-n {
    font-family: var(--sans);
    font-weight: 600;
    font-size: clamp(2.25rem, 4vw, 3.05rem); /* max 55px at 18px root */
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--ink);
  }

  .kf-n small {
    font-size: 0.45em;
    letter-spacing: -0.01em;
    color: var(--accent);
    margin-left: 0.15em;
  }

  .kf-l {
    margin-top: 0.6rem;
    font-size: var(--text-sm);
    line-height: 1.35;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .figures {
      grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    }

    .kf {
      padding: 2.25rem 2rem 2.25rem 0;
    }

    .kf + .kf {
      border-top: 0;
      padding-left: 2rem;
      border-left: 1px solid var(--line);
    }
  }
</style>
