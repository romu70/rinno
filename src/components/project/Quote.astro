---
// Testimonial: large accent quotation mark, italic quote, author and role.
interface Props {
  author: string;
  /** Shown on its own line under the author, e.g. "ex-CTO de Meditect" */
  role?: string;
  fullWidth?: boolean;
}

const { author, role } = Astro.props;
---

<figure class="quote">
  <blockquote>
    <slot />
  </blockquote>
  <figcaption>
    {author}
    {role && <span>{role}</span>}
  </figcaption>
</figure>

<style>
  .quote {
    position: relative;
    padding-top: 2.25rem;
    min-width: 0;
  }

  .quote::before {
    content: "“";
    position: absolute;
    top: -1.1rem;
    left: -0.25rem;
    font-family: var(--serif);
    font-size: 5rem;
    line-height: 1;
    color: var(--accent);
  }

  blockquote {
    margin: 0;
    font-size: 1.3rem;
    font-style: italic;
    line-height: 1.45;
    color: var(--ink);
  }

  blockquote :global(p) {
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  figcaption {
    margin-top: 1rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }

  figcaption span {
    display: block;
    font-weight: 500;
    color: var(--muted);
    margin-top: 0.15rem;
  }

  @media (min-width: 768px) {
    blockquote {
      font-size: 1.3rem;
    }

    figcaption {
      font-size: 0.8rem;
    }
  }
</style>
