---
// Two figures side by side with ✕ (before) / ✓ (after) chips.
// The optional "note" slot renders a coral note under them.
import type { ImageMetadata } from "astro";
import Figure from "./Figure.astro";

interface Side {
  image: ImageMetadata;
  alt: string;
  label: string;
  caption?: string;
}

interface Props {
  before: Side;
  after: Side;
}

const { before, after } = Astro.props;
const hasNote = Astro.slots.has("note");
---

<div class="ba">
  <Figure
    image={before.image}
    alt={before.alt}
    caption={before.caption}
    label={before.label}
    labelTone="no"
    labelIcon
    sizes="(min-width: 1200px) 27rem, (min-width: 768px) 45vw, 100vw"
  />
  <Figure
    image={after.image}
    alt={after.alt}
    caption={after.caption}
    label={after.label}
    labelTone="yes"
    labelIcon
    sizes="(min-width: 1200px) 27rem, (min-width: 768px) 45vw, 100vw"
  />
</div>
{
  hasNote && (
    <p class="note">
      <slot name="note" />
    </p>
  )
}

<style>
  .ba {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 1.75rem;
    align-items: start;
  }

  .note {
    margin-top: 1.5rem;
    padding: 1.1rem 1.4rem;
    border-radius: var(--radius);
    background: var(--coral-soft);
    color: #4a1622;
    font-size: var(--text-sm);
    max-width: var(--prose);
  }

  .note :global(strong) {
    color: #4a1622;
  }

  @media (min-width: 768px) {
    .ba {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
