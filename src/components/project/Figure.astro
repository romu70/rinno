---
// Image figure.
// Default: natural proportions, full column width. Never crop diagrams,
// journeys or screenshots. `crop` + `ratio` are for photos in grids only.
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  image: ImageMetadata;
  alt?: string;
  caption?: string;
  /** Crop to a fixed ratio (photos in grids only) */
  crop?: boolean;
  ratio?: "4/3" | "3/4" | "1/1";
  /** object-position when cropped, e.g. "top" */
  position?: string;
  /** Dark frame, for images with a black background */
  dark?: boolean;
  /** Padded light frame, for small images or white backgrounds */
  pad?: boolean;
  /** Open in the lightbox on click (default: true) */
  clickable?: boolean;
  /** Chip above the image, e.g. "Avant" */
  label?: string;
  labelTone?: "yes" | "no" | "neutral";
  /** Show ✓ / ✕ in the chip */
  labelIcon?: boolean;
  /** Cap the figure width (legacy pages, small images) */
  width?: string;
  height?: string;
  /** Centre the figure when it is narrower than the column */
  center?: boolean;
  /** Legacy prop, no longer has an effect */
  fullWidth?: boolean;
  sizes?: string;
  loading?: "lazy" | "eager";
}

const {
  image,
  alt = "",
  caption,
  crop = false,
  ratio = "4/3",
  position,
  dark = false,
  pad = false,
  clickable = true,
  label,
  labelTone = "neutral",
  labelIcon = false,
  width,
  height,
  center = false,
  sizes = "(min-width: 1200px) 54rem, (min-width: 768px) 90vw, 100vw",
  loading = "lazy",
} = Astro.props;

const widths = [480, 800, 1200, 1600].filter((w) => w < image.width);
widths.push(Math.min(image.width, 2000));

const full = clickable
  ? await getImage({
      src: image,
      width: Math.min(image.width, 2400),
      format: "webp",
      quality: 85,
    })
  : null;

const frameStyle = [
  crop ? `aspect-ratio: ${ratio.replace("/", " / ")}` : "",
  height ? `height: ${height}` : "",
].filter(Boolean).join("; ");
const imgStyle = crop && position ? `object-position: ${position}` : undefined;
const Tag = clickable ? "button" : "div";
const icon = labelTone === "yes" ? "✓" : labelTone === "no" ? "✕" : "";
---

<figure
  class:list={["fig", { center }]}
  style={width ? `max-width: ${width}` : undefined}
>
  {
    label && (
      <span class:list={["chip", labelTone]}>
        {labelIcon && icon && <span aria-hidden="true">{icon}</span>}
        {label}
      </span>
    )
  }
  <Tag
    class:list={["frame", { crop, dark, pad }]}
    style={frameStyle || undefined}
    {...(clickable
      ? {
          type: "button",
          "data-zoom": full!.src,
          "aria-label": `Agrandir : ${alt || caption || "image"}`,
        }
      : {})}
  >
    <Image
      src={image}
      alt={alt}
      widths={widths}
      sizes={sizes}
      format="webp"
      quality={85}
      loading={loading}
      style={imgStyle}
    />
    {
      clickable && (
        <span class="zoom-hint" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            width="16"
            height="16"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7" />
          </svg>
        </span>
      )
    }
  </Tag>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .fig {
    margin: 0;
    min-width: 0;
    width: 100%;
  }

  .fig.center {
    margin-inline: auto;
  }

  .frame {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    font: inherit;
    color: inherit;
  }

  button.frame {
    cursor: zoom-in;
  }

  .frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  button.frame:hover :global(img) {
    transform: scale(1.015);
  }

  .frame.dark {
    background: #111;
    border-color: #222;
  }

  .frame.crop :global(img) {
    height: 100%;
    object-fit: cover;
  }

  /* A fixed height (legacy) keeps the whole image visible */
  .frame[style*="height"]:not(.crop) :global(img) {
    height: 100%;
    object-fit: contain;
  }

  .frame.pad {
    padding: 1rem;
    background: var(--soft);
  }

  .zoom-hint {
    position: absolute;
    right: 0.6rem;
    bottom: 0.6rem;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: rgba(10, 10, 20, 0.72);
    color: #fff;
    display: grid;
    place-items: center;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .frame:hover .zoom-hint,
  .frame:focus-visible .zoom-hint {
    opacity: 1;
  }

  /* Touch screens have no hover: keep the hint visible */
  @media (hover: none) {
    .zoom-hint {
      opacity: 0.85;
    }
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--sans);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    figcaption {
      font-size: 0.8rem;
    }
  }
</style>
