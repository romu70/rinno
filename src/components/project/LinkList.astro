---
// A titled list of useful links (appendix). External links open in a new tab.
interface Props {
  title?: string;
  links: { label: string; href: string }[];
}

const { title = "Liens utiles", links } = Astro.props;
const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<section class="link-list" aria-label={title}>
  <h4>{title}</h4>
  <ul>
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            {...(isExternal(l.href)
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            <span>{l.label}</span>
            <span aria-hidden="true">{isExternal(l.href) ? "↗" : "→"}</span>
            {isExternal(l.href) && <span class="sr-only">(nouvel onglet)</span>}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .link-list {
    padding-top: 2rem;
    border-top: 1px solid var(--line);
    min-width: 0;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
  }

  a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition:
      color 0.2s,
      padding 0.2s;
  }

  a:hover {
    color: var(--accent);
    padding-left: 0.4rem;
  }

  @media (min-width: 768px) {
    a {
      font-size: 0.85rem;
    }
  }
</style>
