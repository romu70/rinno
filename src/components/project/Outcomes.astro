---
// Two cards: what worked (✓ green) and what didn't (✕ coral).
// Fill the "yes" and "no" slots with <li> items.
interface Props {
  yesTitle?: string;
  noTitle?: string;
}

const { yesTitle = "Réussites", noTitle = "Échecs" } = Astro.props;
---

<div class="outcomes">
  <div class="card yes">
    <h3 class="label">{yesTitle}</h3>
    <ul><slot name="yes" /></ul>
  </div>
  <div class="card no">
    <h3 class="label">{noTitle}</h3>
    <ul><slot name="no" /></ul>
  </div>
</div>

<style>
  .outcomes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    min-width: 0;
  }

  .yes h3 {
    color: var(--green);
  }

  .no h3 {
    color: var(--coral);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  ul :global(li) {
    position: relative;
    padding-left: 1.9rem;
    margin-top: 0.75rem;
    font-size: var(--text-sm);
  }

  ul :global(li)::before {
    position: absolute;
    left: 0;
    top: 0.25em;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .yes ul :global(li)::before {
    content: "✓";
    background: var(--green-soft);
    color: var(--green);
  }

  .no ul :global(li)::before {
    content: "✕";
    background: var(--coral-soft);
    color: var(--coral);
  }

  @media (min-width: 768px) {
    .outcomes {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    }

    .card {
      padding: 1.75rem;
    }
  }
</style>
