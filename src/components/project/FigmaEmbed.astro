---
// Embedded Figma prototype in a phone-sized frame, with a caption.
interface Props {
  url: string;
  caption: string;
  /** Max width of the frame (default 22.5rem, a phone) */
  width?: string;
  /** Frame height from 768px (default 43rem) */
  height?: string;
}

const { url, caption, width = "22.5rem", height = "43rem" } = Astro.props;

const embedUrl = url.includes("figma.com/embed")
  ? url
  : `https://www.figma.com/embed?embed_host=share&url=${encodeURIComponent(url)}`;
---

<figure class="figma" style={`--w: ${width}; --h: ${height}`}>
  <div class="frame">
    <iframe src={embedUrl} allowfullscreen title={caption} loading="lazy"
    ></iframe>
  </div>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .figma {
    margin: 0;
    min-width: 0;
    width: 100%;
    max-width: var(--w);
  }

  .frame {
    height: 34rem;
    padding: 0.75rem;
    background: var(--soft);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: var(--radius);
    background: var(--surface);
  }

  figcaption {
    margin-top: 0.6rem;
    font-family: var(--sans);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (min-width: 768px) {
    .frame {
      height: var(--h);
    }

    figcaption {
      font-size: 0.8rem;
    }
  }
</style>
