---
// One numbered item of <LearningsGrid>. The title is optional.
interface Props {
  n: number;
  title?: string;
}

const { n, title } = Astro.props;
---

<article class="learning">
  <span class="n">{String(n).padStart(2, "0")}</span>
  {title && <h3>{title}</h3>}
  <div class="body"><slot /></div>
</article>

<style>
  .learning {
    background: var(--surface);
    padding: 1.6rem;
    min-width: 0;
  }

  .n {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
  }

  h3 {
    margin: 0.6rem 0 0.5rem;
    font-size: 1.15rem;
    line-height: 1.3;
  }

  .body {
    margin-top: 0.5rem;
  }

  .body :global(p) {
    font-size: 1.15rem;
  }

  @media (min-width: 768px) {
    .learning {
      padding: 2rem;
    }

    .n {
      font-size: 0.75rem;
    }
  }
</style>
