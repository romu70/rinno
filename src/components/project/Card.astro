---
// White surface with a border. Put two in a <div class="duo"> for pairs.
interface Props {
  title?: string;
  class?: string;
}

const { title, class: className } = Astro.props;
---

<div class:list={["card", className]}>
  {title && <h3 class="label">{title}</h3>}
  <slot />
</div>

<style>
  .card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 1.5rem;
    min-width: 0;
  }

  .card :global(p),
  .card :global(li) {
    font-size: var(--text-sm);
  }

  .card > :global(:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 768px) {
    .card {
      padding: 1.75rem;
    }
  }
</style>
