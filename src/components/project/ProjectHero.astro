---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface HeroMeta {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  /** Summary line under the title; may contain inline HTML (<em>…) */
  lede?: string;
  meta?: HeroMeta[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Dark background behind the cover (screenshots with a dark UI) */
  imageDark?: boolean;
}

const {
  eyebrow,
  title,
  lede,
  meta = [],
  image,
  imageAlt,
  imageDark = false,
} = Astro.props;

const isExternal = (href: string) => /^https?:\/\//.test(href);
---

<header class="hero">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {lede && <p class="lede" set:html={lede} />}
  {
    meta.length > 0 && (
      <dl class="meta">
        {meta.map((m) => (
          <div>
            <dt>{m.label}</dt>
            <dd>
              {m.href ? (
                <a
                  href={m.href}
                  {...(isExternal(m.href)
                    ? { target: "_blank", rel: "noopener noreferrer" }
                    : {})}
                >
                  {m.value}
                  {isExternal(m.href) && <span aria-hidden="true"> ↗</span>}
                  {isExternal(m.href) && (
                    <span class="sr-only"> (nouvel onglet)</span>
                  )}
                </a>
              ) : (
                m.value
              )}
            </dd>
          </div>
        ))}
      </dl>
    )
  }
  {
    image && (
      <div class:list={["cover", { dark: imageDark }]}>
        <Image
          src={image}
          alt={imageAlt ?? ""}
          widths={[600, 900, 1200, 1600].filter((w) => w <= image.width)}
          sizes="(min-width: 1240px) 1180px, 100vw"
          format="webp"
          quality={85}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    )
  }
</header>

<style>
  .hero {
    padding-top: 0.5rem;
  }

  .eyebrow {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.1rem;
  }

  h1 {
    font-size: clamp(3.3rem, 7vw, 5.55rem); /* max 100px at 18px root */
    line-height: 0.92;
    letter-spacing: -0.045em;
    overflow-wrap: anywhere;
  }

  .lede {
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    line-height: 1.3;
    max-width: 47.5rem;
    margin-top: 1.5rem;
  }

  .lede :global(em) {
    color: var(--ink);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    margin: 2.75rem 0 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }

  .meta dt {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }

  .meta dd {
    margin: 0;
    font-size: var(--text);
    line-height: 1.35;
    color: var(--ink);
  }

  .meta a {
    font-family: var(--sans);
    font-size: 1rem;
    font-weight: 600;
    color: var(--accent);
    text-decoration: none;
  }

  .meta a:hover {
    text-decoration: underline;
  }

  .cover {
    position: relative;
    margin-top: 2.75rem;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--soft);
    aspect-ratio: 3 / 2;
  }

  .cover.dark {
    background: #303030;
    border-color: #303030;
  }

  .cover :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Darkens light covers slightly so they stand out from the page */
  .cover::after {
    content: "";
    position: absolute;
    inset: 0;
    background: rgba(20, 20, 30, 0.14);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: 1rem;
    }

    .meta {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      margin-top: 3.5rem;
    }

    .cover {
      aspect-ratio: 2 / 1;
      margin-top: 3.5rem;
    }
  }

</style>
