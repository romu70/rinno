---
// Section (chapter) with an optional number and h2 title.
// Content flows as blocks; when it contains <Column>s they sit side by side.
interface Props {
  title?: string;
  /** Anchor for the chapter nav */
  id?: string;
  /** Chapter number shown above the title, e.g. 1 → "01" */
  number?: number | string;
  threeColumns?: boolean;
  vertical?: boolean;
  centered?: boolean;
  /** Legacy prop, no longer has an effect */
  noBorder?: boolean;
}

const {
  title,
  id,
  number,
  threeColumns = false,
  vertical = false,
  centered = false,
} = Astro.props;

const num =
  number === undefined
    ? undefined
    : typeof number === "number"
      ? String(number).padStart(2, "0")
      : number;
---

<section
  class="section"
  id={id}
  class:list={{
    "three-columns": threeColumns,
    vertical: vertical,
    centered: centered,
  }}
>
  {num && <p class="chapter-num" aria-hidden="true">{num}</p>}
  {title && <h2>{title}</h2>}
  <div class="section-content">
    <slot />
  </div>
</section>

<style>
  .section {
    padding-bottom: 5rem;
    min-width: 0;
  }

  .chapter-num {
    font-family: var(--sans);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 0.9rem;
  }

  /* Columns side by side (legacy pages) */
  .section-content:has(> :global(.column)) {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .section-content:has(> :global(.column)) > :global(*) {
    margin-top: 0;
  }

  .section-content > :global(.column) {
    flex: 1 1 100%;
  }

  .section-content:has(> :global(.column)) > :global(:not(.column)) {
    flex: 1 1 100%;
  }

  .section.centered h2 {
    text-align: center;
  }

  .section.centered .section-content {
    max-width: 50rem;
    margin: 0 auto;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .section {
      padding-bottom: 7rem;
    }

    .section-content > :global(.column) {
      flex: 1 1 calc(50% - 0.75rem);
    }

    .section.three-columns .section-content > :global(.column) {
      flex: 1 1 calc(33.333% - 1rem);
    }

    .section.vertical .section-content > :global(.column) {
      flex: 1 1 100%;
    }

    .section-content:has(> :global(.column)) {
      gap: 2rem;
    }

    .chapter-num {
      font-size: 0.75rem;
    }
  }
</style>
