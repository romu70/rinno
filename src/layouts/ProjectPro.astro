---
import ProjectBase, { type ProjectHeroProps } from "./ProjectBase.astro";
import type { ImageMetadata } from "astro";
import type { KeyFigure } from "../components/project/KeyFigures.astro";
import { ROUTES } from "../config/routes";

interface Props extends ProjectHeroProps {
  title: string;
  image?: ImageMetadata;
  keyFigures?: KeyFigure[];
  parentPage?: {
    title: string;
    url: string;
  };
}

const {
  title,
  image,
  keyFigures,
  parentPage: explicitParentPage,
  ...hero
} = Astro.props;
const pageTitle = `${title} - Romuald Tisserand`;

const projects = [
  { title: "Meditect", slug: "meditect" },
  { title: "Smart-Rx", slug: "smartrx" },
  { title: "Novyspec", slug: "novyspec" },
];

const currentPath = Astro.url.pathname;
const currentIndex = projects.findIndex((p) => currentPath.includes(p.slug));
const prevProject = currentIndex > 0 ? projects[currentIndex - 1] : null;
const nextProject =
  currentIndex >= 0 && currentIndex < projects.length - 1
    ? projects[currentIndex + 1]
    : null;

// Auto-detect parent page for nested pages
// If we're in /pro/smartrx/logistock, detect parent as /pro/smartrx
let parentPage = explicitParentPage;
if (!parentPage) {
  const pathParts = currentPath.split("/").filter(Boolean);
  if (pathParts.length >= 3 && pathParts[0] === "pro") {
    const projectSlug = pathParts[1];
    const project = projects.find((p) => p.slug === projectSlug);
    if (project) {
      parentPage = { title: project.title, url: `/pro/${projectSlug}` };
    }
  }
}

const breadcrumbs = [
  { name: ROUTES.home.name, url: ROUTES.home.url },
  { name: ROUTES.pro.name, url: ROUTES.pro.url },
  ...(parentPage ? [{ name: parentPage.title, url: parentPage.url }] : []),
  { name: title, url: currentPath },
];

// Sub-pages (case studies) have no previous/next project links
const prev =
  !parentPage && prevProject
    ? {
        label: "Plus récente",
        title: prevProject.title,
        href: `/pro/${prevProject.slug}`,
      }
    : null;
const next =
  !parentPage && nextProject
    ? {
        label: "Plus ancienne",
        title: nextProject.title,
        href: `/pro/${nextProject.slug}`,
      }
    : null;
---

<ProjectBase
  {...hero}
  {title}
  {pageTitle}
  {image}
  {keyFigures}
  {breadcrumbs}
  {prev}
  {next}
  theme="pro"
>
  <slot />
</ProjectBase>
