---
// Shared shell for project pages:
// Breadcrumbs → Hero → Key figures (optional) → [Chapter nav | content] → Pager
import Layout from "./Layout.astro";
import type { ImageMetadata } from "astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import ProjectHero, {
  type HeroMeta,
} from "../components/project/ProjectHero.astro";
import KeyFigures, {
  type KeyFigure,
} from "../components/project/KeyFigures.astro";
import ChapterNav, {
  type ChapterItem,
} from "../components/project/ChapterNav.astro";
import Pager, { type PagerLink } from "../components/project/Pager.astro";
import Lightbox from "../components/project/Lightbox.astro";

interface BreadcrumbItem {
  name: string;
  url: string;
}

export interface ProjectHeroProps {
  /** Small line above the title, e.g. "Healthtech · 2021 — 2024" */
  eyebrow?: string;
  /** Summary under the title; may contain <em> */
  lede?: string;
  /** Hero facts (role, team, link…) */
  meta?: HeroMeta[];
  imageAlt?: string;
  /** Dark background behind the cover */
  imageDark?: boolean;
  /** Chapters for the navigation; no nav when omitted */
  chapters?: ChapterItem[];
  /** Legacy: shown as the eyebrow when no eyebrow is given */
  year?: string;
  /** Legacy: added to the meta as a "Site" link */
  externalLink?: string;
}

interface Props extends ProjectHeroProps {
  title: string;
  pageTitle: string;
  image?: ImageMetadata;
  keyFigures?: KeyFigure[];
  breadcrumbs: BreadcrumbItem[];
  prev?: PagerLink | null;
  next?: PagerLink | null;
  theme?: "pro" | "perso";
}

const {
  title,
  pageTitle,
  eyebrow,
  lede,
  meta,
  image,
  imageAlt,
  imageDark,
  keyFigures,
  chapters,
  breadcrumbs,
  prev,
  next,
  theme = "pro",
  year,
  externalLink,
} = Astro.props;

const heroMeta: HeroMeta[] = meta ?? [];
if (externalLink && !heroMeta.some((m) => m.href === externalLink)) {
  heroMeta.push({ label: "Site", value: "Visiter le site", href: externalLink });
}

const description = lede?.replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
const hasNav = !!chapters && chapters.length > 0;
---

<Layout
  title={pageTitle}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  progress
  bodyClass={theme === "perso" ? "theme-perso" : undefined}
>
  <article class="project">
    <div class="wrap top">
      <Breadcrumbs items={breadcrumbs} />
      <ProjectHero
        eyebrow={eyebrow ?? year}
        title={title}
        lede={lede}
        meta={heroMeta}
        image={image}
        imageAlt={imageAlt ?? `Aperçu du projet ${title}`}
        imageDark={imageDark}
      />
      {keyFigures && keyFigures.length > 0 && <KeyFigures figures={keyFigures} />}
    </div>

    <div class:list={["wrap", "layout", { "has-nav": hasNav }]}>
      {hasNav && <ChapterNav items={chapters!} />}
      <div class="project-content">
        <slot />
        <Pager prev={prev} next={next} />
      </div>
    </div>
  </article>
  <Lightbox />
</Layout>

<style>
  .wrap {
    max-width: var(--wrap);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .top {
    padding-top: 2rem;
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: 2.5rem;
  }

  .project-content {
    min-width: 0;
  }

  @media (min-width: 768px) {
    .top {
      padding-top: 3rem;
    }

    .layout {
      padding-top: 3.5rem;
    }
  }

  @media (min-width: 1200px) {
    .layout.has-nav {
      grid-template-columns: 12.5rem minmax(0, 1fr);
      gap: 4.5rem;
      padding-top: 6rem;
    }
  }

  /* ── Content rules (apply to slotted page markup) ───── */

  /* Prose keeps a readable measure; figures, grids and cards use the column */
  .project-content :global(:where(p, ul, ol, h2, blockquote)) {
    max-width: var(--prose);
  }

  /* Sub-section headings that the chapter nav links to */
  .project-content :global(h3) {
    scroll-margin-top: 7rem;
  }

  .project-content :global(.section-content > h3:not(:first-child)) {
    margin-top: 4rem;
  }

  .project-content :global(.section-content > :is(.fig, .grid-2, .grid-3, .duo):not(:first-child)) {
    margin-top: 1.75rem;
  }

  .project-content :global(.section-content > .fig + p) {
    margin-top: 1.5rem;
  }
</style>
