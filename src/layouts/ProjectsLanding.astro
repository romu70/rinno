---
import Layout from "./Layout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  title: string;
  intro: string;
  description?: string;
  structuredData?: object;
  breadcrumbs?: BreadcrumbItem[];
  accent?: "indigo" | "coral";
}

const { title, intro, description, structuredData, breadcrumbs, accent } =
  Astro.props;
const pageTitle = `${title} | Romuald Tisserand`;
const pageDescription = description || intro;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  structuredData={structuredData}
  bodyClass={accent === "coral" ? "theme-perso" : undefined}
>
  <div class="projects-page">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
    <header class="page-header">
      <h1>{title}</h1>
      <p class="intro">{intro}</p>
    </header>

    <section class="projects-list" aria-label="Projets">
      <slot />
    </section>
  </div>
</Layout>

<style>
  .projects-page {
    max-width: 60rem;
    margin: 0 auto;
    padding: 2rem var(--gutter) 4rem;
  }

  .page-header {
    margin-bottom: 2.5rem;
  }

  h1 {
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  h1::after {
    content: "";
    display: block;
    width: 3rem;
    height: 3px;
    margin-top: 1.25rem;
    background: var(--accent-deco);
  }

  .intro {
    margin-top: 1.25rem;
    max-width: 40rem;
  }

  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .projects-page {
      padding-top: 3rem;
    }

    .page-header {
      margin-bottom: 3.5rem;
    }

    .projects-list {
      gap: 1.5rem;
    }
  }

  @media (min-width: 1440px) {
    .projects-page {
      max-width: 66rem;
    }
  }
</style>
